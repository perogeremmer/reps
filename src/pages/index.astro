---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ExerciseCard from '../components/ExerciseCard.astro';

const exercises = await getCollection('exercises');

// Sort by pubDate
exercises.sort((a, b) => a.data.pubDate.getTime() - b.data.pubDate.getTime());
---

<Layout title="Perogeremmer Reps - Bangun Muscle Memory Logikamu">
  <!-- Hero Section -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-emerald-500/5 via-cyan-500/5 to-transparent pointer-events-none"></div>
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
      <div class="text-center max-w-3xl mx-auto">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-slate-900/80 border border-slate-800 text-sm text-slate-400 mb-6">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Platform latihan fundamental programming</span>
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight mb-6">
          <span class="bg-gradient-to-r from-slate-100 via-slate-200 to-slate-400 bg-clip-text text-transparent">
            Perogeremmer
          </span>
          <span class="bg-gradient-to-r from-emerald-400 to-cyan-400 bg-clip-text text-transparent">
            Reps
          </span>
        </h1>
        <p class="text-lg sm:text-xl text-slate-400 mb-8 leading-relaxed">
          Bangun <span class="text-slate-200 font-medium">muscle memory</span> logikamu. 
          Latih fundamental tanpa AI, satu repetisi pada satu waktu.
        </p>
        <div class="flex justify-center">
          <a 
            href="#exercises"
            class="inline-flex items-center justify-center px-8 py-4 rounded-lg bg-emerald-500 hover:bg-emerald-400 text-white font-semibold text-lg transition-all hover:scale-105 shadow-lg shadow-emerald-500/25"
          >
            Mulai Latihan
            <svg class="ml-2 w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Sintaks Dasar Card -->
  <section class="py-8 border-t border-slate-800/50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <a 
        href="/sintaks-dasar"
        class="group block p-6 rounded-xl relative overflow-hidden bg-gradient-to-br from-slate-900 to-slate-800 border border-emerald-500/30 hover:border-emerald-400/60 transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_0_40px_rgba(16,185,129,0.15)]"
      >
        <!-- Gradient glow effect -->
        <div class="absolute inset-0 bg-gradient-to-r from-emerald-500/10 via-cyan-500/10 to-emerald-500/10 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        <div class="absolute -inset-px bg-gradient-to-r from-emerald-500/20 via-cyan-400/20 to-emerald-500/20 rounded-xl opacity-0 group-hover:opacity-100 blur-sm transition-opacity duration-500"></div>
        <div class="flex items-start justify-between gap-4 mb-4 relative z-10">
          <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-500/20 text-emerald-300 border border-emerald-500/40">
            📖 Referensi
          </span>
          <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-amber-500/20 text-amber-400 border border-amber-500/30 font-semibold animate-pulse">
            ⚡ Wajib Baca
          </span>
        </div>
        
        <h3 class="text-xl font-semibold text-slate-100 mb-2 group-hover:text-emerald-300 transition-colors flex items-center gap-2 relative z-10">
          Sintaks Dasar Pseudocode
          <svg class="w-5 h-5 text-slate-600 group-hover:text-emerald-400 transform group-hover:translate-x-1 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </h3>
        
        <p class="text-slate-400 relative z-10">
          Pelajari fondasi penulisan algoritma: tipe data, operator, kondisional, perulangan, dan array. 
          Panduan lengkap untuk pemula sebelum mulai latihan.
        </p>
        
        <div class="mt-4 flex items-center gap-4 text-sm relative z-10">
          <span class="flex items-center gap-1 text-slate-400">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            8 topik
          </span>
          <span class="flex items-center gap-1 text-slate-400">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            Contoh kode
          </span>
          <span class="flex items-center gap-1 text-slate-400">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            Poin penting
          </span>
        </div>
      </a>
    </div>
  </section>

  <!-- Exercises Grid -->
  <section id="exercises" class="py-16 border-t border-slate-800/50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h2 class="text-2xl font-bold text-slate-100 mb-2">Daftar Latihan</h2>
          <p class="text-slate-400">Pilih latihan sesuai level dan kesulitanmu</p>
        </div>
        <div class="hidden sm:flex items-center gap-2 px-4 py-2 rounded-full bg-slate-800/80 border border-slate-700">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          <span class="text-sm text-slate-300 font-medium">{exercises.length} latihan tersedia</span>
        </div>
      </div>
      
      <!-- Mobile counter -->
      <div class="sm:hidden flex items-center gap-2 mb-6">
        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
        <span class="text-sm text-slate-400">{exercises.length} latihan tersedia</span>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {exercises.map((exercise) => (
          <ExerciseCard exercise={exercise} />
        ))}
      </div>
      
      {exercises.length === 0 && (
        <div class="text-center py-16">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-slate-900 border border-slate-800 mb-4">
            <svg class="w-8 h-8 text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
            </svg>
          </div>
          <p class="text-slate-500">Belum ada latihan tersedia</p>
        </div>
      )}
    </div>
  </section>
</Layout>
